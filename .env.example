# Atlassian OAuth Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Atlassian OAuth App Credentials
# Get these from: https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# OAuth Callback URL (must match what's configured in Atlassian Developer Console)
# For local dev: http://localhost:5175/api/auth/callback
# For production: https://your-domain.vercel.app/api/auth/callback
ATLASSIAN_REDIRECT_URI=http://localhost:5175/api/auth/callback

# Secret for signing cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Atlassian OAuth Scopes (space-separated)
# read:jira-work - Read project and issue data
# read:jira-user - Read user information
# write:jira-work - Update issues (needed for sync)
ATLASSIAN_SCOPES=read:jira-work read:jira-user write:jira-work offline_access
